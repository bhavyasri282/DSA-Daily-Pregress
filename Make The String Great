class Solution {
    public String makeGood(String s) {
        Stack<Character> st=new Stack<>();
        for(char ch:s.toCharArray()){
            if(st.isEmpty()){
                st.push(ch);
            }
            else{
                if(Character.toLowerCase(ch) == Character.toLowerCase(st.peek())
                    && Character.isLowerCase(ch) != Character.isLowerCase(st.peek())) {
                    st.pop();
                }
                else{
                    st.push(ch);
                }
            }
        }
        StringBuilder result = new StringBuilder();
        for(char ch : st) {
            result.append(ch);
        }
        return result.toString();
    }
}
