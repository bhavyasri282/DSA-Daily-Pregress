class Solution {
    public int totalNumbers(int[] digits) {
        int[] count=new int[10];
        for(int digit : digits){
            count[digit]++;
        }
        int ans=0;
        for(int i=1;i<=9;i++){
            for(int j=0;j<=9;j++){
                for(int k=0;k<=8;k+=2){
                    int[] temp = count.clone();
                    if (temp[i] > 0) {
                        temp[i]--;
                        if (temp[j] > 0) {
                            temp[j]--;
                            if (temp[k] > 0) {
                                ans++;
                            }
                        }
                    }
                }
            }
        }
        return ans;
    }
}
