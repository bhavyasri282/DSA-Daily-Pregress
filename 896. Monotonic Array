class Solution {
    public boolean isMonotonic(int[] nums) {
        boolean in=true;
        boolean de=true;
        for(int i=1;i<nums.length;i++){
                if(nums[i-1]>nums[i]){
                    in=false;
                }
                if(nums[i-1]<nums[i]){
                    de=false;
                }
            }
        return in||de;
    }
}
