class Solution {
    public int countSpecialIntegers(int[] nums) {
        int ans=0;
        for(int i=0;i<nums.length;i++){
            boolean alreadySeen = false;
            for(int k = 0; k < i; k++) {
                if(nums[k] == nums[i]) {
                    alreadySeen = true;
                    break;
                }
            }
            if(alreadySeen) {
                continue;
            }
            int first=i;
            int second=-1;
            int third=-1;
            int count=1;
            for(int j=i+1;j<nums.length;j++){
                if(nums[i]==nums[j]){
                    count++;
                    if(count==2){
                        second=j;
                    }else if(count==3){
                        third=j;
                    }
                }
            }
            if(count==3){
                if(second-first==third-second){
                    ans++;
                }
            }   
        }
        return ans;
    }
}©leetcode
