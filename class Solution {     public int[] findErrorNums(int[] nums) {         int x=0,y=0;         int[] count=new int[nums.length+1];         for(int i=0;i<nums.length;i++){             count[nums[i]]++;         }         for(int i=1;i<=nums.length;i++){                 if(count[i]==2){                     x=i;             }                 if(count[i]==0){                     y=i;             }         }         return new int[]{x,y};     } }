class Solution {
    public int[] findErrorNums(int[] nums) {
        int x=0,y=0;
        int[] count=new int[nums.length+1];
        for(int i=0;i<nums.length;i++){
            count[nums[i]]++;
        }
        for(int i=1;i<=nums.length;i++){
                if(count[i]==2){
                    x=i;
            }
                if(count[i]==0){
                    y=i;
            }
        }
        return new int[]{x,y};
    }
}
